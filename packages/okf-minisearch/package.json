{
  "name": "okf-minisearch",
  "version": "2.3.0",
  "description": "Open Knowledge Format optimized search built on MiniSearch.",
  "keywords": [
    "open-knowledge-format",
    "okf",
    "minisearch",
    "markdown-search",
    "knowledge-base",
    "in-memory-search",
    "llm-wiki"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/browser.min.js",
  "unpkg": "./dist/browser.min.js",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:browser",
    "build:browser": "esbuild src/browser.ts --bundle --platform=browser --format=iife --global-name=OkfMiniSearch --target=es2022 --minify --outfile=dist/browser.min.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robhowley/okf-search.git",
    "directory": "packages/okf-minisearch"
  },
  "homepage": "https://github.com/robhowley/okf-search/tree/main/packages/okf-minisearch#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "esbuild": "^0.28.2"
  }
}

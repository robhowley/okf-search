{
  "name": "okf-prepare-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:rust": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked",
    "test": "node scripts/build.mjs && node --test tests/native-boundary.test.mjs"
  },
  "dependencies": {
    "@okf-internal/prepare": "workspace:*"
  }
}

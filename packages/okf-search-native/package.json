{
  "name": "okf-search-native",
  "version": "0.4.0",
  "description": "Search Open Knowledge Format collections at native speed with a lean Rust and Tantivy engine.",
  "keywords": [
    "open-knowledge-format",
    "okf",
    "tantivy",
    "napi-rs",
    "native-search"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./prepared": {
      "types": "./native.d.cts",
      "import": "./native.cjs",
      "require": "./native.cjs",
      "default": "./native.cjs"
    }
  },
  "files": [
    "dist",
    "native.cjs",
    "native.d.cts",
    "okf-search-native.*.node"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:debug": "node scripts/build.mjs",
    "build:facade": "node scripts/build-facade.mjs",
    "check:rust": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
    "test:types": "tsc -p tsconfig.smoke.json",
    "test:package-api": "node --test tests/package-api.test.mjs",
    "test:rust": "cargo test --locked",
    "test:prepare-bundle": "node ../../scripts/check-private-bundling.mjs native",
    "typecheck": "pnpm run test:types",
    "test": "pnpm run test:prepare-bundle && pnpm run test:types && pnpm run test:package-api && vitest run tests/directory.test.ts tests/lifecycle.test.ts tests/prepared-to-native.test.ts tests/root-contract.test.ts tests/search-options.test.ts --no-file-parallelism && pnpm run test:rust",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "@napi-rs/cross-toolchain-x64-target-x86_64": "^1.0.3",
    "esbuild": "^0.28.2",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robhowley/okf-search.git",
    "directory": "packages/okf-search-native"
  },
  "homepage": "https://github.com/robhowley/okf-search/tree/main/packages/okf-search-native#readme",
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "okf-search-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  }
}
